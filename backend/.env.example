# Ruta al dataset de Fotos (SKU por carpeta)
# Ejemplo macOS: /Users/tu_usuario/ruta/Fotos
# Demo incluida en repo (2 SKUs de ejemplo):
DATASET_ROOT=./sample_data/Fotos

# Rutas locales dentro del repo (relativas o absolutas)
DATA_DIR=backend/data
STORAGE_ROOT=backend/storage
FEEDBACK_FILE=backend/data/feedback/feedback.jsonl

CLIP_MODEL_ID=openai/clip-vit-base-patch32
BATCH_SIZE=32
DEFAULT_K=5
RETRIEVAL_TOP_N=50
MAX_EXAMPLES_PER_SKU=3
PROTOTYPE_METHOD=mean

ENABLE_MULTICROP=true
ENABLE_COLOR_TIEBREAK=true
COLOR_TIE_THRESHOLD=0.015

# CORS para desarrollo HTTP
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_KEY=sku-admin-dev
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
