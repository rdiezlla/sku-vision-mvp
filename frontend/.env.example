# URL del backend para desarrollo.
# Si se deja vacia, la app usa automaticamente:
# - http://<host>:8000 (HTTP)
# - https://<host>:8443 (HTTPS)
VITE_BACKEND_URL=

# Clave admin usada por la UI Admin (solo MVP local)
VITE_ADMIN_KEY=sku-admin-dev

# Variables para Vite HTTPS dev (las fija el launcher automaticamente)
# DEV_HTTPS=true
# DEV_SSL_CERT_FILE=../certs/dev-cert.pem
# DEV_SSL_KEY_FILE=../certs/dev-key.pem
